<component type="desktop-application">
  <id>ch.imatt.ClipQR</id>

  <name>ClipQR</name>
  <developer_name>iMatt Sàrl</developer_name>

  <summary>Scan QR codes on screen and from camera</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      Simple app to scan QR codes on screen and from camera, the result is in your clipboard.
    </p>
    <p>
      Works as GUI and CLI, with multiple QR codes and multiple monitors.
    </p>
  </description>

  <launchable type="desktop-id">ch.imatt.ClipQR.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <image>https://gitlab.com/imatt-foss/clipqr/-/raw/master/screenshot.png</image>
      <caption>Screenshot of ClipQR, it has two buttons, one to scan QR codes on screen, the other to scan from camera</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://gitlab.com/imatt-foss/clipqr</url>
  <url type="bugtracker">https://gitlab.com/imatt-foss/clipqr/issues</url>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.3.0" date="2024-08-22">
      <description>
        <p>Fix wayland issues</p>
        <p>Update dependencies</p>
      </description>
    </release>
    <release version="1.2.0" date="2023-12-21">
      <description>
        <p>Add support for CLI usage</p>
        <p>Allow to paste an image from the clipboard</p>
      </description>
    </release>
    <release version="1.1.1" date="2023-11-20">
      <description>
        <p>Fix for flatpak packaging</p>
      </description>
    </release>
    <release version="1.1.0" date="2023-11-19">
      <description>
        <p>Add multiple QR scan support</p>
        <p>Drag an image file to scan it</p>
        <p>Update packages</p>
      </description>
    </release>
    <release version="1.0.1" date="2022-07-23">
      <description>
        <p>Minor changes for packaging</p>
      </description>
    </release>
    <release version="1.0.0" date="2022-07-18">
      <description>
        <p>Initial version</p>
      </description>
    </release>
  </releases>
</component>
